<idea-plugin>
    <id>com.jinloes.prpilot</id>
    <name>PR Pilot</name>
    <vendor>PR Pilot</vendor>
    <description><![CDATA[
        Browse GitHub Pull Requests assigned to you or any accessible repository
        and generate AI-powered code reviews. Preview and edit the review before sharing.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.jcef</depends>
    <depends optional="true" config-file="prpilot-mcp.xml">com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="PR Pilot"
                    secondary="false"
                    anchor="right"
                    icon="AllIcons.Vcs.Branch"
                    factoryClass="com.jinloes.prpilot.ui.PRToolWindowFactory"/>

        <projectService
            serviceImplementation="com.jinloes.prpilot.ui.PrPilotUiCoordinator"/>

        <fileEditorProvider
            implementation="com.jinloes.prpilot.ui.PrReviewFileEditorProvider"/>

        <editorTabTitleProvider
            implementation="com.jinloes.prpilot.ui.PrReviewEditorTabTitleProvider"/>


        <applicationService
            serviceImplementation="com.jinloes.prpilot.settings.PluginSettings"/>

        <applicationService
            serviceImplementation="com.jinloes.prpilot.services.IntellijGitHubService"/>

        <applicationService
            serviceImplementation="com.jinloes.prpilot.services.DraftRecoveryStore"/>

        <applicationService
            serviceImplementation="com.jinloes.prpilot.services.PRNotificationService"/>

        <applicationConfigurable
            parentId="tools"
            instance="com.jinloes.prpilot.settings.PluginSettingsConfigurable"
            id="com.jinloes.prpilot.settings.PluginSettingsConfigurable"
            displayName="PR Pilot"/>

        <notificationGroup id="PR Pilot"
                           displayType="BALLOON"
                           isLogByDefault="true"/>

        <postStartupActivity
            implementation="com.jinloes.prpilot.services.PRNotificationStartup"/>
    </extensions>

    <projectListeners>
        <listener class="com.jinloes.prpilot.ui.PrPilotToolWindowListener"
                  topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
    </projectListeners>

    <actions>
        <action id="PRPilot.Open"
                class="com.jinloes.prpilot.ui.OpenPrPilotAction"
                text="Open PR Pilot"
                description="Open PR Pilot in a main editor tab"
                icon="AllIcons.Vcs.Branch">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
