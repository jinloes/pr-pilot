{
  "name": "pr-pilot-webview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:logic": "node scripts/run-logic-tests.mjs",
    "test:component": "vitest run",
    "test:unit": "npm run test:logic && npm run test:component",
    "test:coverage:logic": "c8 --reporter=text --reporter=html --reporter=lcov --report-dir=coverage/logic --all --src=src --include=\"src/**/*.ts\" --exclude=\"src/**/*.d.ts\" --exclude=\"src/**/*.test.ts\" --exclude=\"src/**/*.component.test.ts\" --exclude=\"src/test/**\" node scripts/run-logic-tests.mjs && node scripts/prefix-lcov-paths.mjs coverage/logic/lcov.info",
    "test:coverage:component": "vitest run --coverage && node scripts/prefix-lcov-paths.mjs coverage/component/lcov.info",
    "test:coverage": "npm run test:coverage:logic && npm run test:coverage:component",
    "test:mutation": "stryker run stryker.config.mjs",
    "a11y:install": "playwright install chromium",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:i18n": "vitest run src/i18n"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@axe-core/react": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@stryker-mutator/core": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.6.1",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  },
  "volta": {
    "node": "20.20.2"
  }
}
