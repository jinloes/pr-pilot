{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vscode", "mocha"],
    "outDir": "./dist-test",
    "rootDir": ".",
    "sourceMap": true,
    "inlineSources": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-test"
  ]
}
